<?xml version="1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
	<link name="NotoSans" type="font" subtype="truetype" src="${nsfont.NotoSans_Regular}" src-bold="${nsfont.NotoSans_Bold}" src-italic="${nsfont.NotoSans_Italic}" src-bolditalic="${nsfont.NotoSans_BoldItalic}" bytes="2" />
	<#if .locale == "zh_CN">
		<link name="NotoSansCJKsc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKsc_Regular}" src-bold="${nsfont.NotoSansCJKsc_Bold}" bytes="2" />
	<#elseif .locale == "zh_TW">
		<link name="NotoSansCJKtc" type="font" subtype="opentype" src="${nsfont.NotoSansCJKtc_Regular}" src-bold="${nsfont.NotoSansCJKtc_Bold}" bytes="2" />
	<#elseif .locale == "ja_JP">
		<link name="NotoSansCJKjp" type="font" subtype="opentype" src="${nsfont.NotoSansCJKjp_Regular}" src-bold="${nsfont.NotoSansCJKjp_Bold}" bytes="2" />
	<#elseif .locale == "ko_KR">
		<link name="NotoSansCJKkr" type="font" subtype="opentype" src="${nsfont.NotoSansCJKkr_Regular}" src-bold="${nsfont.NotoSansCJKkr_Bold}" bytes="2" />
	<#elseif .locale == "th_TH">
		<link name="NotoSansThai" type="font" subtype="opentype" src="${nsfont.NotoSansThai_Regular}" src-bold="${nsfont.NotoSansThai_Bold}" bytes="2" />
	</#if>
    <macrolist>
        <macro id="nlheader">
            <table class="header" style="width: 100%; height: 100.766px;"><tr style="height: 52.25px;">
<td style="height: 100.766px; width: 50.0613%;" rowspan="4"><#if companyInformation.logoUrl?length != 0><@filecabinet nstype="image" style="float: left; margin: 7px;" src="${companyInformation.logoUrl}" /> </#if><br /><br /><br /><br /><span class="nameandaddress">${companyInformation.addressText}</span></td>
<td style="height: 52.25px; width: 50.0613%;" align="right"><span class="title">${record@title}</span></td>
</tr>
<tr style="height: 29.8594px;">
<td style="height: 29.8594px; width: 50.0613%;" align="right"><span class="number">#${record.tranid}</span></td>
</tr>
<tr>
<td style="height: 18.6562px; width: 50.0613%;" align="right">Date:&nbsp; &nbsp;${record.trandate}</td>
</tr>
<tr style="height: 18.6562px;">
<td style="height: 29.8594px; width: 50.0613%;" align="right"><span style="font-size: 10pt;">Memo:&nbsp; </span><span class="number" style="font-size: 10;">${record.memo}</span></td>
</tr></table>
        </macro>
        <macro id="nlfooter">
            <table class="footer" style="width: 100%;"><tr>
<td><barcode codetype="code128" showtext="true" value="${record.tranid}"/></td>
<td align="right"><pagenumber/> of <totalpages/></td>
</tr></table>
        </macro>
    </macrolist>
    <style type="text/css">* {
		<#if .locale == "zh_CN">
			font-family: NotoSans, NotoSansCJKsc, sans-serif;
		<#elseif .locale == "zh_TW">
			font-family: NotoSans, NotoSansCJKtc, sans-serif;
		<#elseif .locale == "ja_JP">
			font-family: NotoSans, NotoSansCJKjp, sans-serif;
		<#elseif .locale == "ko_KR">
			font-family: NotoSans, NotoSansCJKkr, sans-serif;
		<#elseif .locale == "th_TH">
			font-family: NotoSans, NotoSansThai, sans-serif;
		<#else>
			font-family: NotoSans, sans-serif;
		</#if>
		}
		table {
			font-size: 9pt;
			table-layout: fixed;
		}
        th {
            font-weight: bold;
            font-size: 8pt;
            vertical-align: middle;
            padding: 5px 6px 3px;
            background-color: #e3e3e3;
            color: #333333;
        }
        td {
            padding: 4px 6px;
        }
		td p { align:left }
        b {
            font-weight: bold;
            color: #333333;
        }
        table.header td {
            padding: 0px;
            font-size: 10pt;
        }
        table.footer td {
            padding: 0px;
            font-size: 8pt;
        }
        table.itemtable th {
            padding-bottom: 10px;
            padding-top: 10px;
        }
        table.body td {
            padding-top: 2px;
        }
        table.total {
            page-break-inside: avoid;
        }
        tr.totalrow {
            background-color: #e3e3e3;
            line-height: 200%;
        }
        td.totalboxtop {
            font-size: 12pt;
            background-color: #e3e3e3;
        }
        td.addressheader {
            font-size: 8pt;
            padding-top: 6px;
            padding-bottom: 2px;
        }
        td.address {
            padding-top: 0px;
        }
        td.totalboxmid {
            font-size: 28pt;
            padding-top: 20px;
            background-color: #e3e3e3;
        }
        td.totalboxbot {
            background-color: #e3e3e3;
            font-weight: bold;
        }
        span.title {
            font-size: 28pt;
        }
        span.number {
            font-size: 16pt;
        }
        span.itemname {
            font-weight: bold;
            line-height: 150%;
        }
        hr {
            width: 100%;
            color: #d3d3d3;
            background-color: #d3d3d3;
            height: 1px;
        }
</style>
</head>
<body header="nlheader" header-height="10%" footer="nlfooter" footer-height="20pt" padding="0.5in 0.5in 0.5in 0.5in" size="Letter">
    <table style="width: 100%; margin-top: 10px;"><tr>
<td class="addressheader" colspan="3"><strong>${record.billaddress@label}</strong></td>
<td class="addressheader" colspan="3"><strong>${record.shipaddress@label}</strong></td>
</tr>
<tr>
<td class="address" colspan="3" rowspan="2"><br />${record.billaddress}</td>
<td class="address" colspan="3" rowspan="2">${record.shipaddress}</td>
</tr></table>
<table class="body" style="width: 100%; margin-top: 10px;"><tr>
<th>${record.terms@label}</th>
<th>${record.duedate@label}</th>
<th>${record.otherrefnum@label}</th>
<th>${record.salesrep@label}</th>
<th>${record.shipmethod@label}</th>
</tr>
<tr>
<td>${record.terms}</td>
<td>${record.duedate}</td>
<td>${record.otherrefnum}</td>
<td>${record.salesrep}</td>
<td>${record.shipmethod}</td>
</tr></table>
<#if record.item?has_content>
<table class="itemtable" style="width: 100%; margin-top: 10px;"><!-- start items --><#list record.item as item><#if item_index==0>
<thead>
<tr>
<th colspan="3" align="center">${item.quantity@label}</th>
<th colspan="12">${item.item@label}&nbsp;#</th>
<th colspan="12">${item.description@label}</th>
<th colspan="4" align="right">${item.rate@label}</th>
<th colspan="4" align="right">${item.amount@label}</th>
</tr>
</thead>
</#if><tr>
<td colspan="3" align="center">${item.quantity}</td>
<td colspan="12">${item.item}</td>
<td colspan="12">${item.description}</td>
<td colspan="4" align="right">${item.rate}</td>
<td colspan="4" align="right">${item.amount}</td>
</tr>
</#list><!-- end items --></table>
<hr /></#if>
<table class="total" style="width: 100%; margin-top: 10px;"><tr>
<td style="width: 300px;" colspan="4">&nbsp;</td>
<td style="width: 168px;" align="right"><strong>${record.subtotal@label}</strong></td>
<td align="right">${record.subtotal}</td>
</tr>
<#assign shipToCountry = (record.shipcountrycode!"")?upper_case?trim>
<#if shipToCountry == "CA" || shipToCountry == "CANADA">
<tr>
<td style="width: 300px;" colspan="4">&nbsp;</td>
<td style="width: 168px;" align="right"><strong>GST/HST (${record.taxrate}%):</strong></td>
<td align="right">${record.taxtotal}</td>
</tr>
<#if record.tax2total?has_content && record.tax2total != 0>
<tr>
<td style="width: 300px;" colspan="4">&nbsp;</td>
<td style="width: 168px;" align="right"><strong>PST:</strong></td>
<td align="right">${record.tax2total}</td>
</tr>
</#if>
</#if>
<tr>
<td style="width: 300px;" colspan="4">&nbsp;</td>
<td style="width: 168px;" align="right"><strong>Shipping &amp; Handling</strong></td>
<td align="right">${record.shippingcost}</td>
</tr>
<tr class="totalrow">
<td style="width: 300px;" colspan="4">Remit To:</td>
<td style="width: 168px;" align="right"><strong>${record.total@label}</strong></td>
<td align="right">${record.total}</td>
</tr>
<tr>
<td style="width: 320px;" colspan="4">${record.custbody_remittance_address}</td>
<td style="width: 168px;" align="right">&nbsp;</td>
<td align="right">&nbsp;</td>
</tr></table>
</body>
</pdf>